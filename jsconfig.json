{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "checkJs": false,
    "moduleResolution": "node",
    "resolveJsonModule": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "*.js",
    "routes/**/*.js",
    "models/**/*.js",
    "middleware/**/*.js",
    "utils/**/*.js",
    "config/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "uploads",
    "data",
    "coverage",
    "dist",
    "build",
    "tools/geojson",
    "tools/bakhsh",
    "tools/1390",
    "tools/new ship",
    "tools/shahrestan layer",
    "tools/**/*.json",
    "tools/**/*.geojson",
    "tools/**/*.shp",
    "tools/**/*.zip",
    "tools/**/*.exe",
    "**/*.geojson",
    "**/*.shp",
    "**/*.zip"
  ]
}
